                "id": "enabled",
                "title": "Show",
                "type": "boolean",
                "default": true
            },
            {
                "id": "title",
                "title": "Title",
                "type": "string",
                "default": ""
            },
            {
                "id": "month",
                "title": "Month",
                "type": "integer",
                "default": 1,
                "options": {
