{
    "head-trackers": {
        "type": "header",
        "description": "Trackers"
    },
    "trackers": {
        "type": "list",
        "description": "Trackers",
        "columns": [
            {
                "id": "enabled",
                "title": "Show",
                "type": "boolean",
                "default": true
            },
            {
                "id": "title",
                "title": "Title",
                "type": "string",
                "default": ""
            },
            {
                "id": "month",
                "title": "Month",
                "type": "integer",
                "default": 1,
                "options": {
                    "Jan": 1,
                    "Feb": 2,
                    "Mar": 3,
                    "Apr": 4,
                    "May": 5,
                    "Jun": 6,
                    "Jul": 7,
                    "Aug": 8,
                    "Sep": 9,
                    "Oct": 10,
                    "Nov": 11,
                    "Dec": 12
                }
            },
            {
                "id": "day",
                "title": "Day",
                "type": "integer",
                "default": 1,
                "min": 1,
                "max": 31,
                "step": 1
            },
            {
                "id": "year",
                "title": "Year",
                "type": "string",
                "default": ""
            },
            {
                "id": "hour",
                "title": "Hr",
                "type": "string",
                "default": ""
            },
            {
                "id": "clock",
                "title": "AM/PM",
                "type": "string",
                "default": "am",
                "options": {
                    "AM": "am",
                    "PM": "pm",
                    "24H": "24h"
                }
            },
            {
                "id": "minute",
                "title": "Min",
                "type": "integer",
                "default": 0,
                "min": 0,
                "max": 59,
                "step": 1
            },
            {
                "id": "monthly",
                "title": "Monthly",
                "type": "boolean",
                "default": false
            },
            {
                "id": "yearly",
                "title": "Yearly",
                "type": "boolean",
                "default": false
            }
        ],
        "default": [],
        "height": 124
    },
    "help-formats": {
        "type": "label",
        "description": "Year can be blank for Monthly/Yearly. Hour: 1–12 with AM/PM, or 0–23 with 24H."
    },
    "head-display": {
        "type": "header",
        "description": "Display"
    },
    "show-seconds": {
        "type": "switch",
        "default": false,
        "description": "Show seconds"
    },
    "show-since-line": {
        "type": "switch",
        "default": true,
        "description": "Show the \"Since / Until\" line"
    },
    "scale": {
        "type": "spinbutton",
        "default": 1.0,
        "min": 0.5,
        "max": 3.0,
        "step": 0.1,
        "units": "×",
        "description": "Size"
    },
    "head-backup": {
        "type": "header",
        "description": "Backup"
    },
    "backup-button": {
        "type": "button",
        "description": "Back up to a file…",
        "callback": "backupToFile",
        "tooltip": "Save all trackers and display options to a .json file"
    },
    "restore-button": {
        "type": "button",
        "description": "Restore from a file…",
        "callback": "restoreFromFile",
        "tooltip": "Load trackers and display options from a backup. Replaces the current list."
    },
    "zz-bottom-spacer": {
        "type": "header",
        "description": ""
    }
}