    "help-formats": {
        "type": "label",
        "description": "Monthly repeats on the chosen day every month (month and year ignored).\nYearly repeats on the chosen month and day every year (year ignored)."
    },
    "head-display": {
        "type": "header",
        "description": "Display"
    },
    "show-seconds": {
        "type": "switch",
        "default": false,
        "description": "Show seconds"
    },
    "show-since-line": {
        "type": "switch",
        "default": true,
        "description": "Show the \"Since / Until\" line"
    },
    "scale": {
        "type": "spinbutton",
        "default": 1.0,
        "min": 0.5,
        "max": 3.0,
        "step": 0.1,
        "units": "×",
        "description": "Size"
    },
    "head-backup": {
        "type": "header",
        "description": "Backup"
    },
    "backup-button": {
        "type": "button",
        "description": "Back up to a file…",
        "callback": "backupToFile",
        "tooltip": "Save all trackers and display options to a .json file"
    },
    "restore-button": {
        "type": "button",
        "description": "Restore from a file…",
        "callback": "restoreFromFile",
        "tooltip": "Load trackers and display options from a backup. Replaces the current list."
    },
    "zz-bottom-spacer": {
        "type": "header",
        "description": ""
    }
